# Credentials for the dedicated Discord Codex Application. Never reuse the
# Minecraft Discord Bridge Bot token and never commit the real token.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Startup refuses to run if the Codex Application matches this Bridge ID.
DISCORD_BRIDGE_APPLICATION_ID=
DISCORD_GUILD_ID=

# Only these Discord users and channels may start a local Codex process.
# Comma-separated Discord snowflakes; both lists must be non-empty.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# Native Codex thread history is private and disabled until explicitly enabled.
CODEX_DISCORD_HISTORY_ENABLED=false
CODEX_DISCORD_GOALS_ENABLED=false
# Optional: one allow-listed Discord user who owns this host's CLI/VS Code history.
CODEX_HISTORY_OWNER_USER_ID=
# Optional per-thread grants for unowned appServer/unknown-source threads only.
CODEX_HISTORY_THREAD_GRANTS_JSON=[]

# Explicit workspace aliases. Git repositories directly inside
# CODEX_WORKSPACE_ROOT are also discovered automatically at startup.
CODEX_WORKSPACES_JSON={"alchemy":"/home/thomas/workspace/TotemAlchemy","automata":"/home/thomas/workspace/TotemAutomata","core":"/home/thomas/workspace/TotemCore","discord-bridge":"/home/thomas/workspace/TotemDiscordBridge","enchanting":"/home/thomas/workspace/TotemEnchanting","excavation":"/home/thomas/workspace/TotemExcavation","nexus":"/home/thomas/workspace/TotemNexus","remnant":"/home/thomas/workspace/TotemRemnant","vanilla-tweaks":"/home/thomas/workspace/TotemVanillaTweaks"}

# Adds the special workspace:<workspace> choice for cross-module work and is
# the root used to discover direct child Git repositories. New repos appear
# after the Bot restarts and refreshes its guild command registration.
CODEX_WORKSPACE_ROOT=/home/thomas/workspace

# Optional. Use 0 for no time limit; otherwise use 30–7200 seconds.
CODEX_MAX_RUNTIME_SECONDS=0

# Host-owned task budgets: enforce stops at 80 tools/64K context (default).
# observe keeps checkpoints and telemetry, but never stops on these thresholds.
# Combine observe with runtime seconds 0 for terminal-like continuous tasks.
CODEX_USAGE_GUARD_MODE=enforce

# Codex App Server process ownership: auto (default), systemd, or direct.
# auto/systemd use a separate user transient scope when available and record a
# direct-spawn fallback when unavailable. Apply only during an idle restart.
CODEX_WORKLOAD_SCOPE_MODE=auto

# Optional: mirror fixed work statuses to the local TotemWorkspace Viewer.
# Execution, approvals and questions stay in Discord's local runtime.
# All three values must be set together and the channel must already be
# in DISCORD_ALLOWED_CHANNEL_IDS. Use the same secret as the Workspace Bridge;
# keep it only in 0600 environment files.
TOTEM_WORKSPACE_SYNC_URL=http://127.0.0.1:18765/
TOTEM_WORKSPACE_SYNC_TOKEN=
TOTEM_WORKSPACE_SYNC_CHANNEL_ID=
TOTEM_WORKSPACE_SYNC_WORKSPACE=workspace
